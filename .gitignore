# Local IDE and editor settings
.vs/
.vscode/
.idea/

# Build trees and generated output
build/
build-*/
out/
src/build/
# Anchored to repo root (not bin/ or lib/, which would also match e.g.
# third_party/raylib-*/lib/ -- vendored binaries we actually want tracked).
# CMAKE_RUNTIME_OUTPUT_DIRECTORY/CMAKE_LIBRARY_OUTPUT_DIRECTORY already put
# real build output under build*/bin, build*/lib, covered above regardless.
/bin/
/lib/
/generated/
.cargo-target/
# Cargo workspace target dir (rust/Cargo.toml covers both rapier_bridge and
# bevy_bridge as one workspace, so this is the one real output path -- the
# old src/engine/physics/rapier_bridge/target/ entry predated the crates'
# move to rust/ and never matched anything).
rust/target/
# Persistent CPM dependency source cache (see root CMakeLists.txt) -- kept
# outside build/ on purpose so it survives a clean reconfigure.
.cpm-cache/
# Configure-time generated by CMake when sccache is found (see root
# CMakeLists.txt) -- not authored, machine-specific path to the sccache binary.
rust/.cargo/
Testing/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
build.ninja
.ninja_deps
.ninja_log
Makefile

# CMake and tool-generated local config
CMakeUserPresets.json

# Obsidian vault state that is user/window specific. Shared vault settings live
# in .obsidian/*.json and project notes live in Notes/.
.obsidian/workspace*.json
.obsidian/cache/
.obsidian/plugins/
.obsidian/trash/

# MSVC, link, and debug artifacts
*.obj
*.iobj
*.ipdb
*.ilk
*.pdb
*.recipe
*.tlog
*.lastbuildstate
*.vcxproj.user

# Logs
*.log
__pycache__/
*.pyc


# Personal tooling (CommandCode, Sisyphus, OMX agent cache)
.commandcode/
.sisyphus/
.omx/
/.token-optimizer
